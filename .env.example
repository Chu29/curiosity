NODE_ENV=development
PORT=3001

POSTGRES_PORT=5434
REDIS_PORT=6379

DATABASE_URL=postgresql://postgres:postgres@localhost:5434/curiosity_dev?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=dev_jwt_access_secret_key_at_least_32_chars_long
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_at_least_32_chars_long

# AI Provider Configuration (groq | mock)
LLM_PROVIDER=groq
LLM_API_KEY=mock-groq-api-key
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1

EMBEDDING_API_KEY=mock-embedding-api-key
TRANSCRIPTION_API_KEY=mock-transcription-api-key

# Local filesystem storage: no Docker or MinIO required.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=.local-storage

# S3-compatible local storage alternative. For production R2, replace these
# with the Cloudflare account endpoint and an R2 API token; do not commit secrets.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_BUCKET=curiosity-uploads
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Cloudflare R2 production example:
# STORAGE_PROVIDER=s3
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_FORCE_PATH_STYLE=false
# STORAGE_AUTO_CREATE_BUCKET=false
# STORAGE_BUCKET=curiosity-presentations
# STORAGE_ACCESS_KEY=<r2-access-key-id>
# STORAGE_SECRET_KEY=<r2-secret-access-key>
